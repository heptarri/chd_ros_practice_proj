<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- base_footprint is the ground-projection frame used by odometry.
       It is massless; Gazebo will lump the fixed joint into base_link. -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${base_link_z}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual name="chassis_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <material name="body_orange">
        <color rgba="0.95 0.45 0.08 1.0"/>
      </material>
    </visual>

    <!-- Cabin above the main body: 4.70 m car, 1.50 m total height. -->
    <visual name="cabin_visual">
      <origin xyz="-0.15 0 0.55" rpy="0 0 0"/>
      <geometry>
        <box size="2.20 1.70 0.35"/>
      </geometry>
      <material name="body_dark">
        <color rgba="0.11 0.12 0.13 1.0"/>
      </material>
    </visual>

    <!-- Lower floor pan, narrower than the track so the wheels stay visible. -->
    <visual name="skirt_visual">
      <origin xyz="0 0 -0.42" rpy="0 0 0"/>
      <geometry>
        <box size="4.30 1.30 0.15"/>
      </geometry>
      <material name="body_dark">
        <color rgba="0.11 0.12 0.13 1.0"/>
      </material>
    </visual>

    <!-- Front grille / bumper and rear roof equipment box are decorative. -->
    <visual name="front_panel_visual">
      <origin xyz="2.34 0 -0.20" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 1.50 0.30"/>
      </geometry>
      <material name="panel_grey">
        <color rgba="0.20 0.22 0.24 1.0"/>
      </material>
    </visual>

    <visual name="rear_box_visual">
      <origin xyz="-0.90 0 0.835" rpy="0 0 0"/>
      <geometry>
        <box size="0.70 1.20 0.22"/>
      </geometry>
      <material name="panel_grey">
        <color rgba="0.20 0.22 0.24 1.0"/>
      </material>
    </visual>

    <collision name="chassis_collision">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>

    <collision name="cabin_collision">
      <origin xyz="-0.15 0 0.55" rpy="0 0 0"/>
      <geometry>
        <box size="2.20 1.70 0.35"/>
      </geometry>
    </collision>

    <!-- Effective height includes the cabin and roof equipment. -->
    <xacro:box_inertial mass="${chassis_mass}"
                        x="${chassis_length}"
                        y="${chassis_width}"
                        z="1.30"/>
  </link>

  <!-- A fixed frame at the front face, convenient for future sensors. -->
  <link name="front_frame"/>
  <joint name="front_frame_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_frame"/>
    <origin xyz="2.36 0 -0.20" rpy="0 0 0"/>
  </joint>

</robot>
