<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- A wheel is a cylinder whose axis is the URDF y axis.
       The cylinder primitive is defined about z, hence rpy="${pi/2} 0 0". -->
  <xacro:macro name="wheel" params="name x y">
    <link name="${name}_wheel_link">
      <visual name="${name}_tyre_visual">
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="tyre_black">
          <color rgba="0.05 0.05 0.05 1.0"/>
        </material>
      </visual>

      <!-- A light-coloured rim makes wheel rotation visible in Gazebo. -->
      <visual name="${name}_rim_visual">
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${0.22}" length="${wheel_width + 0.004}"/>
        </geometry>
        <material name="rim_silver">
          <color rgba="0.75 0.76 0.78 1.0"/>
        </material>
      </visual>

      <!-- The collision name must start with the link name (or be empty).
           Otherwise sdformat prefixes it with "fixed_joint_lump" and silently
           drops the <gazebo> friction extension below, leaving the wheels at
           the default friction. -->
      <collision name="${name}_wheel_link_tyre_collision">
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>

      <xacro:cylinder_inertial mass="${wheel_mass}"
                               radius="${wheel_radius}"
                               length="${wheel_width}"/>
    </link>

    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_wheel_link"/>
      <origin xyz="${x} ${y} ${wheel_z}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <!-- Car-sized wheel: about 136 Nm per wheel for 1 m/s^2, with a large
           reserve for scrubbing the tyres during skid-steer turns. -->
      <limit effort="1500.0" velocity="60.0"/>
      <dynamics damping="0.05" friction="0.0"/>
    </joint>

    <!-- Skid-steer friction: mu1 is the longitudinal tread grip, mu2 is the
         lateral scrub.  Keeping mu2 well below mu1 lets the four non-steered
         wheels slide sideways when the differential drive rotates the car.
         With mu1 == mu2 the long 2.8 m wheelbase cannot overcome the lateral
         friction and the car barely turns.  fdir1 keeps mu1 along the rolling
         direction (wheel link +x). -->
    <gazebo reference="${name}_wheel_link">
      <mu1>1.5</mu1>
      <mu2>0.2</mu2>
      <fdir1>1 0 0</fdir1>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
    </gazebo>
  </xacro:macro>

  <xacro:wheel name="front_left"  x="${wheel_x}"  y="${wheel_y}"/>
  <xacro:wheel name="rear_left"   x="${-wheel_x}" y="${wheel_y}"/>
  <xacro:wheel name="front_right" x="${wheel_x}"  y="${-wheel_y}"/>
  <xacro:wheel name="rear_right"  x="${-wheel_x}" y="${-wheel_y}"/>

</robot>
