<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- A wheel is a cylinder whose axis is the URDF y axis.
       The cylinder primitive is defined about z, hence rpy="${pi/2} 0 0". -->
  <xacro:macro name="wheel" params="name x y">
    <link name="${name}_wheel_link">
      <visual name="${name}_tyre_visual">
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="tyre_black">
          <color rgba="0.05 0.05 0.05 1.0"/>
        </material>
      </visual>

      <!-- A light-coloured rim makes wheel rotation visible in Gazebo. -->
      <visual name="${name}_rim_visual">
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${0.055}" length="${wheel_width + 0.004}"/>
        </geometry>
        <material name="rim_silver">
          <color rgba="0.75 0.76 0.78 1.0"/>
        </material>
      </visual>

      <collision name="${name}_tyre_collision">
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>

      <xacro:cylinder_inertial mass="${wheel_mass}"
                               radius="${wheel_radius}"
                               length="${wheel_width}"/>
    </link>

    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_wheel_link"/>
      <origin xyz="${x} ${y} ${wheel_z}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="20.0" velocity="30.0"/>
      <dynamics damping="0.05" friction="0.0"/>
    </joint>

    <!-- High friction is needed for skid-steer / four-wheel differential drive.
         The values are Gazebo URDF extensions and are converted to SDF surface
         parameters when the robot is spawned. -->
    <gazebo reference="${name}_wheel_link">
      <mu1>1.2</mu1>
      <mu2>1.2</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
    </gazebo>
  </xacro:macro>

  <xacro:wheel name="front_left"  x="${wheel_x}"  y="${wheel_y}"/>
  <xacro:wheel name="rear_left"   x="${-wheel_x}" y="${wheel_y}"/>
  <xacro:wheel name="front_right" x="${wheel_x}"  y="${-wheel_y}"/>
  <xacro:wheel name="rear_right"  x="${-wheel_x}" y="${-wheel_y}"/>

</robot>
