<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============================================================
       Four-wheel differential drive.

       The two left wheels are driven with the same velocity command,
       and so are the two right wheels.  This is the usual "skid
       steer" approximation of a four-wheel differential platform.
       Gazebo's DiffDrive system accepts more than one left_joint and
       more than one right_joint (it stores them in vectors).
       ============================================================ -->
  <gazebo>
    <plugin filename="libignition-gazebo-diff-drive-system.so"
        name="ignition::gazebo::systems::DiffDrive">
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>

      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>

      <!-- ROS-side command topic after ros_gz_bridge remapping -->
      <topic>cmd_vel</topic>

      <!-- Odometry and TF.  The child frame is the ground projection. -->
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>

      <!-- Speed and acceleration limits make the simulated vehicle
           behave like a small inspection robot, not a racing car. -->
      <min_linear_velocity>-1.0</min_linear_velocity>
      <max_linear_velocity>1.5</max_linear_velocity>
      <min_angular_velocity>-2.0</min_angular_velocity>
      <max_angular_velocity>2.0</max_angular_velocity>
      <min_linear_acceleration>-1.0</min_linear_acceleration>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <min_angular_acceleration>-2.0</min_angular_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
    </plugin>

    <!-- Publishes /joint_states as gz.msgs.Model; bridge it to
         sensor_msgs/msg/JointState for robot_state_publisher. -->
    <plugin filename="libignition-gazebo-joint-state-publisher-system.so"
        name="ignition::gazebo::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>
  </gazebo>

</robot>
