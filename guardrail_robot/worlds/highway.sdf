<?xml version="1.0"?>
<!--
  highway.sdf — 120 m two-lane highway section for guardrail inspection.

  The cross-section follows a realistic highway:
    * two 3.75 m lanes (7.50 m carriageway)
    * 2.50 m right-hand hard shoulder
    * 0.15 m edge lines, 6 m dash / 9 m gap centre line
    * W-beam guardrail at the outer edge of the shoulder:
      0.31 m beam, top at 0.755 m, posts every 4 m

  Axes: +x forward, +y left, +z up.
  Right-hand lane centre: y = -1.875.
  Normal rail: x in [-8,30] and [38,100], y=-6.15.
  Damage: [30,34] missing rail/post; [34,38] bent rail; debris and drums.
-->
<sdf version="1.8">
  <world name="highway">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <gravity>0 0 -9.81</gravity>

    <scene>
      <ambient>0.55 0.58 0.62 1</ambient>
      <background>0.60 0.72 0.86 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 20 0 0.55 0.35</pose>
      <diffuse>0.95 0.93 0.88 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <direction>-0.45 0.35 -1.0</direction>
    </light>

    <plugin filename="libignition-gazebo-physics-system.so"
        name="ignition::gazebo::systems::Physics"/>

    <plugin filename="libignition-gazebo-user-commands-system.so"
        name="ignition::gazebo::systems::UserCommands"/>

    <plugin filename="libignition-gazebo-scene-broadcaster-system.so"
        name="ignition::gazebo::systems::SceneBroadcaster"/>

    <plugin filename="libignition-gazebo-sensors-system.so"
        name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- ==================== Road surface ==================== -->
    <model name="highway_surface">
      <static>true</static>
      <link name="surface_link">

        <visual name="grass">
          <pose>0 0 -0.03 0 0 0</pose>
          <geometry><plane><normal>0 0 1</normal><size>240 160</size></plane></geometry>
          <material>
            <ambient>0.06 0.12 0.04 1</ambient>
            <diffuse>0.12 0.25 0.08 1</diffuse>
          </material>
        </visual>
        <collision name="grass_collision">
          <pose>0 0 -0.03 0 0 0</pose>
          <geometry><plane><normal>0 0 1</normal><size>240 160</size></plane></geometry>
          <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>

        <!-- Paved carriageway (2 x 3.75 m) plus the 2.50 m hard shoulder. -->
        <visual name="asphalt">
          <pose>50 -1.25 0 0 0 0</pose>
          <geometry><box><size>120 10.0 0.04</size></box></geometry>
          <material>
            <ambient>0.055 0.058 0.062 1</ambient>
            <diffuse>0.16 0.17 0.18 1</diffuse>
          </material>
        </visual>
        <collision name="asphalt_collision">
          <pose>50 -1.25 0 0 0 0</pose>
          <geometry><box><size>120 10.0 0.04</size></box></geometry>
          <surface><friction><ode><mu>0.95</mu><mu2>0.95</mu2></ode></friction></surface>
        </collision>

        <!-- Solid edge lines: left edge of the carriageway and the
             carriageway / hard-shoulder boundary (0.15 m wide). -->
        <visual name="edge_left">
          <pose>50 3.65 0.025 0 0 0</pose>
          <geometry><box><size>118 0.15 0.006</size></box></geometry>
          <material><ambient>0.8 0.8 0.76 1</ambient><diffuse>0.95 0.95 0.9 1</diffuse></material>
        </visual>
        <visual name="edge_right">
          <pose>50 -3.65 0.025 0 0 0</pose>
          <geometry><box><size>118 0.15 0.006</size></box></geometry>
          <material><ambient>0.8 0.8 0.76 1</ambient><diffuse>0.95 0.95 0.9 1</diffuse></material>
        </visual>

        <!-- Broken centre line: 6 m dash, 9 m gap (15 m cycle). -->
        <visual name="dash_0"><pose>-6 0 0.025 0 0 0</pose><geometry><box><size>6 0.15 0.006</size></box></geometry><material><ambient>0.8 0.8 0.76 1</ambient><diffuse>0.95 0.95 0.9 1</diffuse></material></visual>
        <visual name="dash_1"><pose>9 0 0.025 0 0 0</pose><geometry><box><size>6 0.15 0.006</size></box></geometry><material><ambient>0.8 0.8 0.76 1</ambient><diffuse>0.95 0.95 0.9 1</diffuse></material></visual>
        <visual name="dash_2"><pose>24 0 0.025 0 0 0</pose><geometry><box><size>6 0.15 0.006</size></box></geometry><material><ambient>0.8 0.8 0.76 1</ambient><diffuse>0.95 0.95 0.9 1</diffuse></material></visual>
        <visual name="dash_3"><pose>39 0 0.025 0 0 0</pose><geometry><box><size>6 0.15 0.006</size></box></geometry><material><ambient>0.8 0.8 0.76 1</ambient><diffuse>0.95 0.95 0.9 1</diffuse></material></visual>
        <visual name="dash_4"><pose>54 0 0.025 0 0 0</pose><geometry><box><size>6 0.15 0.006</size></box></geometry><material><ambient>0.8 0.8 0.76 1</ambient><diffuse>0.95 0.95 0.9 1</diffuse></material></visual>
        <visual name="dash_5"><pose>69 0 0.025 0 0 0</pose><geometry><box><size>6 0.15 0.006</size></box></geometry><material><ambient>0.8 0.8 0.76 1</ambient><diffuse>0.95 0.95 0.9 1</diffuse></material></visual>
        <visual name="dash_6"><pose>84 0 0.025 0 0 0</pose><geometry><box><size>6 0.15 0.006</size></box></geometry><material><ambient>0.8 0.8 0.76 1</ambient><diffuse>0.95 0.95 0.9 1</diffuse></material></visual>
        <visual name="dash_7"><pose>99 0 0.025 0 0 0</pose><geometry><box><size>6 0.15 0.006</size></box></geometry><material><ambient>0.8 0.8 0.76 1</ambient><diffuse>0.95 0.95 0.9 1</diffuse></material></visual>

      </link>
    </model>

    <!-- ==================== Guardrail ==================== -->
    <model name="guardrail">
      <static>true</static>
      <link name="guardrail_link">

        <!-- Continuous W-beam -8..30 -->
        <visual name="rail_left">
          <pose>11 -6.15 0.60 0 0 0</pose>
          <geometry><box><size>38 0.07 0.31</size></box></geometry>
          <material><ambient>0.44 0.47 0.5 1</ambient><diffuse>0.68 0.72 0.75 1</diffuse></material>
        </visual>
        <collision name="rail_left_collision">
          <pose>11 -6.15 0.60 0 0 0</pose>
          <geometry><box><size>38 0.07 0.31</size></box></geometry>
          <surface><friction><ode><mu>0.7</mu><mu2>0.7</mu2></ode></friction></surface>
        </collision>
        <visual name="rail_left_ridge_a"><pose>11 -6.105 0.53 0 0 0</pose><geometry><box><size>37.9 0.04 0.06</size></box></geometry><material><ambient>0.44 0.47 0.5 1</ambient><diffuse>0.68 0.72 0.75 1</diffuse></material></visual>
        <visual name="rail_left_ridge_b"><pose>11 -6.105 0.67 0 0 0</pose><geometry><box><size>37.9 0.04 0.06</size></box></geometry><material><ambient>0.44 0.47 0.5 1</ambient><diffuse>0.68 0.72 0.75 1</diffuse></material></visual>

        <!-- Continuous W-beam 38..100 -->
        <visual name="rail_right">
          <pose>69 -6.15 0.60 0 0 0</pose>
          <geometry><box><size>62 0.07 0.31</size></box></geometry>
          <material><ambient>0.44 0.47 0.5 1</ambient><diffuse>0.68 0.72 0.75 1</diffuse></material>
        </visual>
        <collision name="rail_right_collision">
          <pose>69 -6.15 0.60 0 0 0</pose>
          <geometry><box><size>62 0.07 0.31</size></box></geometry>
          <surface><friction><ode><mu>0.7</mu><mu2>0.7</mu2></ode></friction></surface>
        </collision>
        <visual name="rail_right_ridge_a"><pose>69 -6.105 0.53 0 0 0</pose><geometry><box><size>61.9 0.04 0.06</size></box></geometry><material><ambient>0.44 0.47 0.5 1</ambient><diffuse>0.68 0.72 0.75 1</diffuse></material></visual>
        <visual name="rail_right_ridge_b"><pose>69 -6.105 0.67 0 0 0</pose><geometry><box><size>61.9 0.04 0.06</size></box></geometry><material><ambient>0.44 0.47 0.5 1</ambient><diffuse>0.68 0.72 0.75 1</diffuse></material></visual>

        <!-- Bent W-beam 34..38, displaced towards the road -->
        <visual name="rail_bent">
          <pose>36 -5.92 0.58 0.12 0 0.10</pose>
          <geometry><box><size>3.9 0.07 0.31</size></box></geometry>
          <material><ambient>0.44 0.47 0.5 1</ambient><diffuse>0.68 0.72 0.75 1</diffuse></material>
        </visual>
        <collision name="rail_bent_collision">
          <pose>36 -5.92 0.58 0.12 0 0.10</pose>
          <geometry><box><size>3.9 0.07 0.31</size></box></geometry>
          <surface><friction><ode><mu>0.7</mu><mu2>0.7</mu2></ode></friction></surface>
        </collision>
        <visual name="rail_bent_ridge_a"><pose>36 -5.875 0.51 0.12 0 0.10</pose><geometry><box><size>3.8 0.04 0.06</size></box></geometry><material><ambient>0.44 0.47 0.5 1</ambient><diffuse>0.68 0.72 0.75 1</diffuse></material></visual>
        <visual name="rail_bent_ridge_b"><pose>36 -5.875 0.65 0.12 0 0.10</pose><geometry><box><size>3.8 0.04 0.06</size></box></geometry><material><ambient>0.44 0.47 0.5 1</ambient><diffuse>0.68 0.72 0.75 1</diffuse></material></visual>

        <!-- Posts every 4 m; none in the missing section (x=32) and the
             bent section is supported by the displaced post at x=36. -->
        <visual name="post_0"><pose>-8 -6.25 0.375 0 0 0</pose><geometry><box><size>0.12 0.12 0.75</size></box></geometry><material><ambient>0.25 0.27 0.29 1</ambient><diffuse>0.42 0.44 0.46 1</diffuse></material></visual>
        <collision name="post_0_collision"><pose>-8 -6.25 0.375 0 0 0</pose><geometry><box><size>0.12 0.12 0.75</size></box></geometry></collision>
        <visual name="post_1"><pose>-4 -6.25 0.375 0 0 0</pose><geometry><box><size>0.12 0.12 0.75</size></box></geometry><material><ambient>0.25 0.27 0.29 1</ambient><diffuse>0.42 0.44 0.46 1</diffuse></material></visual>
        <collision name="post_1_collision"><pose>-4 -6.25 0.375 0 0 0</pose><geometry><box><size>0.12 0.12 0.75</size></box></geometry></collision>
        <visual name="post_2"><pose>0 -6.25 0.375 0 0 0</pose><geometry><box><size>0.12 0.12 0.75</size></box></geometry><material><ambient>0.25 0.27 0.29 1</ambient><diffuse>0.42 0.44 0.46 1</diffuse></material></visual>
        <collision name="post_2_collision"><pose>0 -6.25 0.375 0 0 0</pose><geometry><box><size>0.12 0.12 0.75</size></box></geometry></collision>
        <visual name="post_3"><pose>4 -6.25 0.375 0 0 0</pose><geometry><box><size>0.12 0.12 0.75</size></box></geometry><material><ambient>0.25 0.27 0.29 1</ambient><diffuse>0.42 0.44 0.46 1</diffuse></material></visual>
        <collision name="post_3_collision"><pose>4 -6.25 0.375 0 0 0</pose><geometry><box><size>0.12 0.12 0.75</size></box></geometry></collision>
        <visual name="post_4"><pose>8 -6.25 0.375 0 0 0</pose><geometry><box><size>0.12 0.12 0.75</size></box></geometry><material><ambient>0.25 0.27 0.29 1</ambient><diffuse>0.42 0.44 0.46 1</diffuse></material></visual>
        <collision name="post_4_collision"><pose>8 -6.25 0.375 0 0 0</pose><geometry><box><size>0.12 0.12 0.75</size></box></geometry></collision>
        <visual name="post_5"><pose>12 -6.25 0.375 0 0 0</pose><geometry><box><size>0.12 0.12 0.75</size></box></geometry><material><ambient>0.25 0.27 0.29 1</ambient><diffuse>0.42 0.44 0.46 1</diffuse></material></visual>
        <collision name="post_5_collision"><pose>12 -6.25 0.375 0 0 0</pose><geometry><box><size>0.12 0.12 0.75</size></box></geometry></collision>
        <visual name="post_6"><pose>16 -6.25 0.375 0 0 0</pose><geometry><box><size>0.12 0.12 0.75</size></box></geometry><material><ambient>0.25 0.27 0.29 1</ambient><diffuse>0.42 0.44 0.46 1</diffuse></material></visual>
        <collision name="post_6_collision"><pose>16 -6.25 0.375 0 0 0</pose><geometry><box><size>0.12 0.12 0.75</size></box></geometry></collision>
        <visual name="post_7"><pose>20 -6.25 0.375 0 0 0</pose><geometry><box><size>0.12 0.12 0.75</size></box></geometry><material><ambient>0.25 0.27 0.29 1</ambient><diffuse>0.42 0.44 0.46 1</diffuse></material></visual>
        <collision name="post_7_collision"><pose>20 -6.25 0.375 0 0 0</pose><geometry><box><size>0.12 0.12 0.75</size></box></geometry></collision>
        <visual name="post_8"><pose>24 -6.25 0.375 0 0 0</pose><geometry><box><size>0.12 0.12 0.75</size></box></geometry><material><ambient>0.25 0.27 0.29 1</ambient><diffuse>0.42 0.44 0.46 1</diffuse></material></visual>
        <collision name="post_8_collision"><pose>24 -6.25 0.375 0 0 0</pose><geometry><box><size>0.12 0.12 0.75</size></box></geometry></collision>
        <visual name="post_9"><pose>28 -6.25 0.375 0 0 0</pose><geometry><box><size>0.12 0.12 0.75</size></box></geometry><material><ambient>0.25 0.27 0.29 1</ambient><diffuse>0.42 0.44 0.46 1</diffuse></material></visual>
        <collision name="post_9_collision"><pose>28 -6.25 0.375 0 0 0</pose><geometry><box><size>0.12 0.12 0.75</size></box></geometry></collision>
        <visual name="post_10"><pose>40 -6.25 0.375 0 0 0</pose><geometry><box><size>0.12 0.12 0.75</size></box></geometry><material><ambient>0.25 0.27 0.29 1</ambient><diffuse>0.42 0.44 0.46 1</diffuse></material></visual>
        <collision name="post_10_collision"><pose>40 -6.25 0.375 0 0 0</pose><geometry><box><size>0.12 0.12 0.75</size></box></geometry></collision>
        <visual name="post_11"><pose>44 -6.25 0.375 0 0 0</pose><geometry><box><size>0.12 0.12 0.75</size></box></geometry><material><ambient>0.25 0.27 0.29 1</ambient><diffuse>0.42 0.44 0.46 1</diffuse></material></visual>
        <collision name="post_11_collision"><pose>44 -6.25 0.375 0 0 0</pose><geometry><box><size>0.12 0.12 0.75</size></box></geometry></collision>
        <visual name="post_12"><pose>48 -6.25 0.375 0 0 0</pose><geometry><box><size>0.12 0.12 0.75</size></box></geometry><material><ambient>0.25 0.27 0.29 1</ambient><diffuse>0.42 0.44 0.46 1</diffuse></material></visual>
        <collision name="post_12_collision"><pose>48 -6.25 0.375 0 0 0</pose><geometry><box><size>0.12 0.12 0.75</size></box></geometry></collision>
        <visual name="post_13"><pose>52 -6.25 0.375 0 0 0</pose><geometry><box><size>0.12 0.12 0.75</size></box></geometry><material><ambient>0.25 0.27 0.29 1</ambient><diffuse>0.42 0.44 0.46 1</diffuse></material></visual>
        <collision name="post_13_collision"><pose>52 -6.25 0.375 0 0 0</pose><geometry><box><size>0.12 0.12 0.75</size></box></geometry></collision>
        <visual name="post_14"><pose>56 -6.25 0.375 0 0 0</pose><geometry><box><size>0.12 0.12 0.75</size></box></geometry><material><ambient>0.25 0.27 0.29 1</ambient><diffuse>0.42 0.44 0.46 1</diffuse></material></visual>
        <collision name="post_14_collision"><pose>56 -6.25 0.375 0 0 0</pose><geometry><box><size>0.12 0.12 0.75</size></box></geometry></collision>
        <visual name="post_15"><pose>60 -6.25 0.375 0 0 0</pose><geometry><box><size>0.12 0.12 0.75</size></box></geometry><material><ambient>0.25 0.27 0.29 1</ambient><diffuse>0.42 0.44 0.46 1</diffuse></material></visual>
        <collision name="post_15_collision"><pose>60 -6.25 0.375 0 0 0</pose><geometry><box><size>0.12 0.12 0.75</size></box></geometry></collision>
        <visual name="post_16"><pose>64 -6.25 0.375 0 0 0</pose><geometry><box><size>0.12 0.12 0.75</size></box></geometry><material><ambient>0.25 0.27 0.29 1</ambient><diffuse>0.42 0.44 0.46 1</diffuse></material></visual>
        <collision name="post_16_collision"><pose>64 -6.25 0.375 0 0 0</pose><geometry><box><size>0.12 0.12 0.75</size></box></geometry></collision>
        <visual name="post_17"><pose>68 -6.25 0.375 0 0 0</pose><geometry><box><size>0.12 0.12 0.75</size></box></geometry><material><ambient>0.25 0.27 0.29 1</ambient><diffuse>0.42 0.44 0.46 1</diffuse></material></visual>
        <collision name="post_17_collision"><pose>68 -6.25 0.375 0 0 0</pose><geometry><box><size>0.12 0.12 0.75</size></box></geometry></collision>
        <visual name="post_18"><pose>72 -6.25 0.375 0 0 0</pose><geometry><box><size>0.12 0.12 0.75</size></box></geometry><material><ambient>0.25 0.27 0.29 1</ambient><diffuse>0.42 0.44 0.46 1</diffuse></material></visual>
        <collision name="post_18_collision"><pose>72 -6.25 0.375 0 0 0</pose><geometry><box><size>0.12 0.12 0.75</size></box></geometry></collision>
        <visual name="post_19"><pose>76 -6.25 0.375 0 0 0</pose><geometry><box><size>0.12 0.12 0.75</size></box></geometry><material><ambient>0.25 0.27 0.29 1</ambient><diffuse>0.42 0.44 0.46 1</diffuse></material></visual>
        <collision name="post_19_collision"><pose>76 -6.25 0.375 0 0 0</pose><geometry><box><size>0.12 0.12 0.75</size></box></geometry></collision>
        <visual name="post_20"><pose>80 -6.25 0.375 0 0 0</pose><geometry><box><size>0.12 0.12 0.75</size></box></geometry><material><ambient>0.25 0.27 0.29 1</ambient><diffuse>0.42 0.44 0.46 1</diffuse></material></visual>
        <collision name="post_20_collision"><pose>80 -6.25 0.375 0 0 0</pose><geometry><box><size>0.12 0.12 0.75</size></box></geometry></collision>
        <visual name="post_21"><pose>84 -6.25 0.375 0 0 0</pose><geometry><box><size>0.12 0.12 0.75</size></box></geometry><material><ambient>0.25 0.27 0.29 1</ambient><diffuse>0.42 0.44 0.46 1</diffuse></material></visual>
        <collision name="post_21_collision"><pose>84 -6.25 0.375 0 0 0</pose><geometry><box><size>0.12 0.12 0.75</size></box></geometry></collision>
        <visual name="post_22"><pose>88 -6.25 0.375 0 0 0</pose><geometry><box><size>0.12 0.12 0.75</size></box></geometry><material><ambient>0.25 0.27 0.29 1</ambient><diffuse>0.42 0.44 0.46 1</diffuse></material></visual>
        <collision name="post_22_collision"><pose>88 -6.25 0.375 0 0 0</pose><geometry><box><size>0.12 0.12 0.75</size></box></geometry></collision>
        <visual name="post_23"><pose>92 -6.25 0.375 0 0 0</pose><geometry><box><size>0.12 0.12 0.75</size></box></geometry><material><ambient>0.25 0.27 0.29 1</ambient><diffuse>0.42 0.44 0.46 1</diffuse></material></visual>
        <collision name="post_23_collision"><pose>92 -6.25 0.375 0 0 0</pose><geometry><box><size>0.12 0.12 0.75</size></box></geometry></collision>
        <visual name="post_24"><pose>96 -6.25 0.375 0 0 0</pose><geometry><box><size>0.12 0.12 0.75</size></box></geometry><material><ambient>0.25 0.27 0.29 1</ambient><diffuse>0.42 0.44 0.46 1</diffuse></material></visual>
        <collision name="post_24_collision"><pose>96 -6.25 0.375 0 0 0</pose><geometry><box><size>0.12 0.12 0.75</size></box></geometry></collision>
        <visual name="post_25"><pose>100 -6.25 0.375 0 0 0</pose><geometry><box><size>0.12 0.12 0.75</size></box></geometry><material><ambient>0.25 0.27 0.29 1</ambient><diffuse>0.42 0.44 0.46 1</diffuse></material></visual>
        <collision name="post_25_collision"><pose>100 -6.25 0.375 0 0 0</pose><geometry><box><size>0.12 0.12 0.75</size></box></geometry></collision>
        <visual name="post_fallen"><pose>33.0 -5.70 0.08 0 1.45 0.60</pose><geometry><box><size>0.12 0.12 0.75</size></box></geometry><material><ambient>0.25 0.27 0.29 1</ambient><diffuse>0.42 0.44 0.46 1</diffuse></material></visual>
        <collision name="post_fallen_collision"><pose>33.0 -5.70 0.08 0 1.45 0.60</pose><geometry><box><size>0.12 0.12 0.75</size></box></geometry></collision>
        <visual name="post_bent"><pose>36 -6.03 0.34 0.18 0 0.12</pose><geometry><box><size>0.12 0.12 0.75</size></box></geometry><material><ambient>0.25 0.27 0.29 1</ambient><diffuse>0.42 0.44 0.46 1</diffuse></material></visual>
        <collision name="post_bent_collision"><pose>36 -6.03 0.34 0.18 0 0.12</pose><geometry><box><size>0.12 0.12 0.75</size></box></geometry></collision>

      </link>
    </model>

    <!-- ==================== Damage debris and traffic drums ==================== -->
    <model name="work_zone">
      <static>true</static>
      <link name="work_zone_link">

        <visual name="broken_rail">
          <pose>31.6 -5.60 0.05 0 0 0.9</pose>
          <geometry><box><size>1.6 0.30 0.06</size></box></geometry>
          <material><ambient>0.44 0.47 0.5 1</ambient><diffuse>0.68 0.72 0.75 1</diffuse></material>
        </visual>
        <collision name="broken_rail_collision">
          <pose>31.6 -5.60 0.05 0 0 0.9</pose>
          <geometry><box><size>1.6 0.30 0.06</size></box></geometry>
        </collision>

        <visual name="drum_0">
          <pose>28.8 -4.05 0.42 0 0 0</pose>
          <geometry>
            <cylinder><radius>0.20</radius><length>0.80</length></cylinder>
          </geometry>
          <material>
            <ambient>0.65 0.1 0.01 1</ambient>
            <diffuse>0.98 0.28 0.02 1</diffuse>
          </material>
        </visual>
        <visual name="drum_0_band">
          <pose>28.8 -4.05 0.60 0 0 0</pose>
          <geometry>
            <cylinder><radius>0.205</radius><length>0.12</length></cylinder>
          </geometry>
          <material>
            <ambient>0.85 0.85 0.82 1</ambient>
            <diffuse>0.95 0.95 0.92 1</diffuse>
          </material>
        </visual>
        <collision name="drum_0_collision">
          <pose>28.8 -4.05 0.42 0 0 0</pose>
          <geometry>
            <cylinder><radius>0.20</radius><length>0.80</length></cylinder>
          </geometry>
        </collision>

        <visual name="drum_1">
