<?xml version="1.0"?>
<!--
  highway.sdf — 120 m two-lane highway with a left-hand bend.

  The centreline is a circular arc of radius 120 m over about 57 degrees
  (120 m arc length).  Cross-section follows a realistic highway:
    * two 3.75 m lanes (7.50 m carriageway)
    * 2.50 m right-hand hard shoulder
    * 0.15 m edge lines, 6 m dash / 9 m gap centre line
    * W-beam guardrail at the outer edge of the shoulder:
      0.31 m beam, top at 0.755 m, posts every 4 m

  Axes: +x forward, +y left, +z up.
  Arc: centre at (0, 120), road starts at the origin heading +x.
  Right-hand lane centre at the start: (0, -1.875), heading +x.
  Normal rail: arc length [-8,30] and [38,100], y=-6.15.
  Damage: [30,34] missing rail/post; [34,38] bent rail; debris and drums.
-->
<sdf version="1.8">
  <world name="highway">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <gravity>0 0 -9.81</gravity>

    <scene>
      <ambient>0.55 0.58 0.62 1</ambient>
      <background>0.60 0.72 0.86 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 20 0 0.55 0.35</pose>
      <diffuse>0.95 0.93 0.88 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <direction>-0.45 0.35 -1.0</direction>
    </light>

    <plugin filename="libignition-gazebo-physics-system.so"
        name="ignition::gazebo::systems::Physics"/>

    <plugin filename="libignition-gazebo-user-commands-system.so"
        name="ignition::gazebo::systems::UserCommands"/>

    <plugin filename="libignition-gazebo-scene-broadcaster-system.so"
        name="ignition::gazebo::systems::SceneBroadcaster"/>

    <plugin filename="libignition-gazebo-sensors-system.so"
        name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- ==================== Road surface ==================== -->
    <model name="highway_surface">
      <static>true</static>
      <link name="surface_link">

        <visual name="grass">
          <pose>0 0 -0.03 0 0 0</pose>
          <geometry><plane><normal>0 0 1</normal><size>260 200</size></plane></geometry>
          <material>
            <ambient>0.06 0.12 0.04 1</ambient>
            <diffuse>0.12 0.25 0.08 1</diffuse>
          </material>
        </visual>
        <collision name="grass_collision">
          <pose>0 0 -0.03 0 0 0</pose>
          <geometry><plane><normal>0 0 1</normal><size>260 200</size></plane></geometry>
          <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>

        <!-- Paved carriageway (2 x 3.75 m) plus the 2.50 m right-hand
             hard shoulder, split into short chords along the bend. -->
        <visual name="asphalt_0"><pose>-9.085227 -0.909144 0.000000 0.000000 0.000000 -0.075000</pose><geometry><box><size>2.180 10.02 0.04</size></box></geometry><material><ambient>0.055 0.058 0.062 1</ambient><diffuse>0.16 0.17 0.18 1</diffuse></material></visual>
        <collision name="asphalt_0_collision"><pose>-9.085227 -0.909144 0.000000 0.000000 0.000000 -0.075000</pose><geometry><box><size>2.180 10.02 0.04</size></box></geometry><surface><friction><ode><mu>0.95</mu><mu2>0.95</mu2></ode></friction></surface></collision>
